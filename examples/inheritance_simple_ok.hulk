type Point(x: Number, y: Number) {
    x = x;
    y = y;

    getX() => self.x;
    getY() => self.y;
}

type Point3D(x: Number, y: Number, z: Number) inherits Point(x, y) {
    z = z;

    getZ() => self.z;
}

let p = new Point(3, 4);
print("2D Point: " @ p.getX() @ ", " @ p.getY());

let p3d = new Point3D(1, 2, 3);
print("3D Point: " @ p3d.getX() @ ", " @ p3d.getY() @ ", " @ p3d.getZ());
