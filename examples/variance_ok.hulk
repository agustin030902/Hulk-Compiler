type Animal { }
type Dog inherits Animal { }
type Cat inherits Animal { }

protocol Walker {
    walk(): Animal;
}

protocol Feeder {
    feed(animal: Dog): Unit;
}

type FriendlyDog {
    walk(): Dog => new Dog();
    feed(animal: Animal): Unit => print("fed");
}

let w: Walker = new FriendlyDog();
let f: Feeder = new FriendlyDog();
