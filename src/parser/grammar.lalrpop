use crate::lexer::TokenKind;
use crate::parser::expression::{
    BinaryExpr, BinaryOp, BlockExpr, BuiltinCallExpr, BuiltinFunction, DestructiveAssignExpr, Expr,
    ElifBranch, FunctionCallExpr, FunctionDecl, FunctionParam, IfExpr, LetBinding, LetInExpr,
    Literal, Program, Span, Statement, UnaryExpr, UnaryOp, WhileExpr,
};

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum TokenKind {
        "let" => TokenKind::Let,
        "function" => TokenKind::Function,
        "while" => TokenKind::While,
        "if" => TokenKind::If,
        "elif" => TokenKind::Elif,
        "else" => TokenKind::Else,
        "print" => TokenKind::Print,
        "PI" => TokenKind::Pi,
        "E" => TokenKind::E,
        "sin" => TokenKind::Sin,
        "cos" => TokenKind::Cos,
        "sqrt" => TokenKind::Sqrt,
        "exp" => TokenKind::Exp,
        "log" => TokenKind::Log,
        "rand" => TokenKind::Rand,
        "in" => TokenKind::In,
        ":=" => TokenKind::DestructiveAssign,
        "=>" => TokenKind::Arrow,
        "=" => TokenKind::Assign,
        "+" => TokenKind::Add,
        "^" => TokenKind::Power,
        "@" => TokenKind::Concat,
        "-" => TokenKind::Minus,
        "*" => TokenKind::Multiply,
        "/" => TokenKind::Divide,
        "==" => TokenKind::EqualEqual,
        "!=" => TokenKind::NotEqual,
        "<" => TokenKind::Less,
        ">" => TokenKind::Greater,
        "<=" => TokenKind::LessEqual,
        ">=" => TokenKind::GreaterEqual,
        "&&" => TokenKind::And,
        "||" => TokenKind::Or,
        "!" => TokenKind::Not,
        "," => TokenKind::Comma,
        ";" => TokenKind::Semicolon,
        "(" => TokenKind::LeftParen,
        ")" => TokenKind::RightParen,
        "{" => TokenKind::LeftBrace,
        "}" => TokenKind::RightBrace,
        "identifier" => TokenKind::Identifier(<String>),
        "number" => TokenKind::Number(<String>),
        "string" => TokenKind::String(<String>),
        "boolean" => TokenKind::Boolean(<String>),
        "unknown" => TokenKind::Unknown,
        "eof" => TokenKind::EOF,
    }
}

pub Program: Program = {
    <functions:FunctionDecls> <statements:Statements> "eof" => Program { functions, statements },
};

FunctionDecls: Vec<FunctionDecl> = {
    => vec![],
    <first:FunctionDecl> <rest:FunctionDecls> => {
        let mut functions = vec![first];
        functions.extend(rest);
        functions
    },
};

FunctionDecl: FunctionDecl = {
    <l:@L> "function" <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" "=>" <body:Expr> ";" <r:@R> => FunctionDecl {
        name: id.0,
        name_span: id.1,
        params,
        body,
        span: Span::new(l, r),
    },
    <l:@L> "function" <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body) = body else {
            unreachable!("BlockExpr rule must produce Expr::Block");
        };

        Ok(FunctionDecl {
            name: id.0,
            name_span: id.1,
            params,
            body: Expr::Block(body),
            span: Span::new(l, r),
        })
    },
};

FunctionParams: Vec<FunctionParam> = {
    => vec![],
    <first:FunctionParam> <rest:("," <FunctionParam>)*> => {
        let mut params = vec![first];
        for param in rest {
            params.push(param);
        }
        params
    },
};

FunctionParam: FunctionParam = {
    <l:@L> <name:"identifier"> <r:@R> => FunctionParam {
        name,
        span: Span::new(l, r),
    },
};

Statements: Vec<Statement> = {
    => vec![],
    <first:Statement> <rest:StatementTail> => {
        let mut statements = vec![first];
        statements.extend(rest);
        statements
    },
};

StatementTail: Vec<Statement> = {
    ";" <rest:StatementsAfterSemicolon> => rest,
    => vec![],
};

StatementsAfterSemicolon: Vec<Statement> = {
    => vec![],
    <next:Statement> <rest:StatementTail> => {
        let mut statements = vec![next];
        statements.extend(rest);
        statements
    },
};

Statement: Statement = {
    <l:@L> "let" <id:IdentifierWithSpan> "=" <value:Expr> <r:@R> => Statement::Let {
        name: id.0,
        name_span: id.1,
        value,
        span: Span::new(l, r),
    },
    <l:@L> <id:IdentifierWithSpan> "=" <value:Expr> <r:@R> => Statement::Assign {
        name: id.0,
        name_span: id.1,
        value,
        span: Span::new(l, r),
    },
    <l:@L> <value:Expr> <r:@R> => Statement::Expr {
        value,
        span: Span::new(l, r),
    },
};

Expr: Expr = {
    Conditional,
};

Conditional: Expr = {
    IfExpr,
    LetIn,
};

LetIn: Expr = {
    <l:@L> "let" <bindings:LetBindings> "in" <body:Expr> <r:@R> => Expr::LetIn(LetInExpr {
        bindings,
        body: Box::new(body),
        span: Span::new(l, r),
    }),
    Assignment,
};

LetBindings: Vec<LetBinding> = {
    <first:LetBinding> <rest:("," <LetBinding>)*> => {
        let mut items = Vec::new();
        items.push(first);
        for binding in rest {
            items.push(binding);
        }
        items
    }
};

LetBinding: LetBinding = {
    <l:@L> <id:IdentifierWithSpan> "=" <value:Expr> <r:@R> => LetBinding {
        name: id.0,
        value,
        span: Span::new(l, r),
    },
};

Assignment: Expr = {
    <l:@L> <id:IdentifierWithSpan> ":=" <value:Assignment> <r:@R> => Expr::DestructiveAssign(DestructiveAssignExpr {
        name: id.0,
        name_span: id.1,
        value: Box::new(value),
        span: Span::new(l, r),
    }),
    LogicalOr,
};

LogicalOr: Expr = {
    <l:@L> <left:LogicalOr> "||" <right:LogicalAnd> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Or,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    LogicalAnd,
};

LogicalAnd: Expr = {
    <l:@L> <left:LogicalAnd> "&&" <right:Equality> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::And,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Equality,
};

Equality: Expr = {
    <l:@L> <left:Equality> "==" <right:Comparison> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Equal,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Equality> "!=" <right:Comparison> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::NotEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Comparison,
};

Comparison: Expr = {
    <l:@L> <left:Comparison> "<" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Less,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> ">" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Greater,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> "<=" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::LessEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> ">=" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::GreaterEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Term,
};

Term: Expr = {
    <l:@L> <left:Term> "+" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Add,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Term> "@" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Concat,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Term> "-" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Sub,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Factor,
};

Factor: Expr = {
    <l:@L> <left:Factor> "*" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Mul,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Factor> "/" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Div,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Unary,
};

Unary: Expr = {
    <l:@L> "!" <expr:Unary> <r:@R> => Expr::Unary(UnaryExpr {
        op: UnaryOp::Not,
        expr: Box::new(expr),
        span: Span::new(l, r),
    }),
    <l:@L> "-" <expr:Unary> <r:@R> => Expr::Unary(UnaryExpr {
        op: UnaryOp::Neg,
        expr: Box::new(expr),
        span: Span::new(l, r),
    }),
    Power,
};

Power: Expr = {
    <l:@L> <left:Primary> "^" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Pow,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Primary,
};

Primary: Expr = {
    WhileExpr,
    BlockExpr,
    <call:BuiltinCallExpr> => call,
    <call:FunctionCallExpr> => call,
    <literal:LiteralExpr> => literal,
    <variable:VariableExpr> => variable,
    "(" <expr:Expr> ")" => expr,
};

FunctionCallExpr: Expr = {
    <l:@L> <id:IdentifierWithSpan> "(" <args:CallArgs> ")" <r:@R> => Expr::FunctionCall(FunctionCallExpr {
        name: id.0,
        name_span: id.1,
        args,
        span: Span::new(l, r),
    }),
};

CallArgs: Vec<Expr> = {
    => vec![],
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut args = vec![first];
        for arg in rest {
            args.push(arg);
        }
        args
    },
};

IfExpr: Expr = {
    <l:@L> "if" "(" <condition:Expr> ")" <then_branch:Expr> "else" <else_branch:Expr> <r:@R> => {
        Expr::If(IfExpr {
            condition: Box::new(condition),
            then_branch: Box::new(then_branch),
            elif_branches: Vec::new(),
            else_branch: Box::new(else_branch),
            span: Span::new(l, r),
        })
    },
    <l:@L> "if" "(" <condition:Expr> ")" <then_branch:Expr> <elif_branches:ElifBranches> "else" <else_branch:Expr> <r:@R> => {
        Expr::If(IfExpr {
            condition: Box::new(condition),
            then_branch: Box::new(then_branch),
            elif_branches,
            else_branch: Box::new(else_branch),
            span: Span::new(l, r),
        })
    },
};

ElifBranches: Vec<ElifBranch> = {
    <first:ElifBranch> <rest:ElifBranch*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

ElifBranch: ElifBranch = {
    <l:@L> "elif" "(" <condition:Expr> ")" <body:Expr> <r:@R> => ElifBranch {
        condition,
        body,
        span: Span::new(l, r),
    },
};

BuiltinCallExpr: Expr = {
    <l:@L> "sin" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Sin,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "cos" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Cos,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "sqrt" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Sqrt,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "print" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
    function: BuiltinFunction::Print,
    args: vec![arg],
    span: Span::new(l, r),
    }),
    <l:@L> "exp" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Exp,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "log" "(" <base:Expr> "," <value:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Log,
        args: vec![base, value],
        span: Span::new(l, r),
    }),
    <l:@L> "rand" "(" ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Rand,
        args: vec![],
        span: Span::new(l, r),
    }),
};

IdentifierWithSpan: (String, Span) = {
    <l:@L> <name:"identifier"> <r:@R> => (name, Span::new(l, r)),
};

VariableExpr: Expr = {
    <l:@L> <name:"identifier"> <r:@R> => Expr::Variable {
        name,
        span: Span::new(l, r),
    },
};

BlockExpr: Expr = {
    <l:@L> "{" <statements:Statements> "}" <r:@R> => Expr::Block(BlockExpr {
        statements,
        span: Span::new(l, r),
    }),
};

WhileExpr: Expr = {
    <l:@L> "while" "(" <condition:Expr> ")" <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body) = body else {
            unreachable!("BlockExpr rule must produce Expr::Block");
        };

        Ok(Expr::While(WhileExpr {
            condition: Box::new(condition),
            body,
            span: Span::new(l, r),
        }))
    },
};

LiteralExpr: Expr = {
    <l:@L> "PI" <r:@R> => Expr::Literal {
        value: Literal::Float(std::f64::consts::PI),
        span: Span::new(l, r),
    },
    <l:@L> "E" <r:@R> => Expr::Literal {
        value: Literal::Float(std::f64::consts::E),
        span: Span::new(l, r),
    },
    <l:@L> <raw:"number"> <r:@R> =>? {
        if raw.contains('.') {
            match raw.parse::<f64>() {
                Ok(v) => Ok(Expr::Literal {
                    value: Literal::Float(v),
                    span: Span::new(l, r),
                }),
                Err(_) => Err(lalrpop_util::ParseError::User {
                    error: format!("Invalid float literal: {}", raw),
                }),
            }
        } else {
            match raw.parse::<i64>() {
                Ok(v) => Ok(Expr::Literal {
                    value: Literal::Integer(v),
                    span: Span::new(l, r),
                }),
                Err(_) => Err(lalrpop_util::ParseError::User {
                    error: format!("Invalid integer literal: {}", raw),
                }),
            }
        }
    },
    <l:@L> <raw:"boolean"> <r:@R> => Expr::Literal {
        value: Literal::Boolean(raw == "true"),
        span: Span::new(l, r),
    },
    <l:@L> <raw:"string"> <r:@R> => Expr::Literal {
        value: Literal::String(raw),
        span: Span::new(l, r),
    },
};
