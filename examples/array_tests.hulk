let arr: Number[] = new Number[5] in {
    let i = 0 in
        while (i < 5) {
            arr[i] := i * i;
            i := i + 1;
        };
    if (arr[0] == 0) print("ok") else print("fail");
    if (arr[1] == 1) print("ok") else print("fail");
    if (arr[2] == 4) print("ok") else print("fail");
    if (arr[3] == 9) print("ok") else print("fail");
    if (arr[4] == 16) print("ok") else print("fail");
};

let arr: Number[] = new Number[4]{ i -> i + 1 } in {
    if (array_sum(arr) == 10) print("ok") else print("fail");
};

{
    let a: Number[] = new Number[10] in
        if (a.size() == 10) print("ok") else print("fail");
    let b: Number[] = new Number[1] in
        if (b.size() == 1) print("ok") else print("fail");
    let c: Number[] = new Number[100] in
        if (c.size() == 100) print("ok") else print("fail");
};

let a: Number[] = new Number[5]{ i -> i + 1 } in {
    let total = 0, j = 0 in {
        while (j < a.size()) {
            total := total + a[j];
            j := j + 1;
        };
        if (total == 15) print("ok") else print("fail");
    };
};
