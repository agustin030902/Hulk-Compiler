use crate::lexer::TokenKind;
use crate::parser::expression::{
    AsExpr, AssignTarget, ArrayIndexExpr, ArrayLiteralExpr, BinaryExpr, BinaryOp, BlockExpr, BuiltinCallExpr, BuiltinFunction,
    DestructiveAssignExpr, ElifBranch, Expr, ForExpr, FunctionCallExpr, FunctionDecl, FunctionParam, IfExpr,
    IsExpr, LambdaExpr, LetBinding, LetInExpr, Literal, MemberAccessExpr, MethodCallExpr, MethodDecl, NewArrayExpr, NewExpr,
    Program, ProgramItem, InterfaceDecl, InterfaceMethodDecl, Span, Statement, TypeAnnotation,
    TypeAttribute, TypeDecl, TypeMemberDecl, TypeParam, UnaryExpr, UnaryOp, WhileExpr,
};

grammar;

extern {
    type Location = usize;
    type Error = String;

    enum TokenKind {
        "let" => TokenKind::Let,
        "function" => TokenKind::Function,
        "type" => TokenKind::Type,
        "interface" => TokenKind::Interface,
        "extends" => TokenKind::Extends,
        "new" => TokenKind::New,
        "while" => TokenKind::While,
        "for" => TokenKind::For,
        "range" => TokenKind::Range,
        "if" => TokenKind::If,
        "elif" => TokenKind::Elif,
        "else" => TokenKind::Else,
        "print" => TokenKind::Print,
        "PI" => TokenKind::Pi,
        "E" => TokenKind::E,
        "sin" => TokenKind::Sin,
        "cos" => TokenKind::Cos,
        "sqrt" => TokenKind::Sqrt,
        "exp" => TokenKind::Exp,
        "log" => TokenKind::Log,
        "rand" => TokenKind::Rand,
        "in" => TokenKind::In,
        "null" => TokenKind::Null,
        "inherits" => TokenKind::Inherits,
        "is" => TokenKind::Is,
        "as" => TokenKind::As,
        ":=" => TokenKind::DestructiveAssign,
        ":" => TokenKind::Colon,
        "=>" => TokenKind::Arrow,
        "=" => TokenKind::Assign,
        "+" => TokenKind::Add,
        "^" => TokenKind::Power,
        "@" => TokenKind::Concat,
        "@@" => TokenKind::ConcatSpace,
        "-" => TokenKind::Minus,
        "*" => TokenKind::Multiply,
        "/" => TokenKind::Divide,
        "%" => TokenKind::Mod,
        "==" => TokenKind::EqualEqual,
        "!=" => TokenKind::NotEqual,
        "<" => TokenKind::Less,
        ">" => TokenKind::Greater,
        "<=" => TokenKind::LessEqual,
        ">=" => TokenKind::GreaterEqual,
        "&&" => TokenKind::And,
        "||" => TokenKind::Or,
        "!" => TokenKind::Not,
        "," => TokenKind::Comma,
        ";" => TokenKind::Semicolon,
        "(" => TokenKind::LeftParen,
        ")" => TokenKind::RightParen,
        "." => TokenKind::Dot,
        "{" => TokenKind::LeftBrace,
        "}" => TokenKind::RightBrace,
        "[" => TokenKind::LeftBracket,
        "]" => TokenKind::RightBracket,
        "->" => TokenKind::ThinArrow,
        "identifier" => TokenKind::Identifier(<String>),
        "number" => TokenKind::Number(<String>),
        "string" => TokenKind::String(<String>),
        "boolean" => TokenKind::Boolean(<String>),
        "unknown" => TokenKind::Unknown,
        "eof" => TokenKind::EOF,
    }
}

pub Program: Program = {
    <items:Declaration*> <statements:Statements> "eof" => {
        let mut interfaces = Vec::new();
        let mut types = Vec::new();
        let mut functions = Vec::new();
        for item in items {
            match item {
                ProgramItem::Interface(p) => interfaces.push(p),
                ProgramItem::Type(t) => types.push(t),
                ProgramItem::Function(f) => functions.push(f),
            }
        }
        Program {
            types,
            interfaces,
            functions,
            statements,
        }
    },
};

Declaration: ProgramItem = {
    <p:InterfaceDecl> => ProgramItem::Interface(p),
    <t:TypeDecl> => ProgramItem::Type(t),
    <f:FunctionDecl> => ProgramItem::Function(f),
};

InterfaceDecl: InterfaceDecl = {
    <l:@L> "interface" <id:IdentifierWithSpan> <inheritance:InterfaceInheritance> "{" <methods:InterfaceMembers> "}" <r:@R> => {
        let (parent_name, parent_span) = inheritance;
        InterfaceDecl {
            name: id.0,
            name_span: id.1,
            parent_name,
            parent_span,
            methods,
            span: Span::new(l, r),
        }
    },
};

InterfaceInheritance: (Option<String>, Option<Span>) = {
    => (None, None),
    <pl:@L> "extends" <parent_id:IdentifierWithSpan> <pr:@R> => (Some(parent_id.0), Some(Span::new(pl, pr))),
};

InterfaceMembers: Vec<InterfaceMethodDecl> = {
    => vec![],
    <first:InterfaceMember> <rest:InterfaceMembers> => {
        let mut members = vec![first];
        members.extend(rest);
        members
    },
};

InterfaceMember: InterfaceMethodDecl = {
    <l:@L> <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" ":" <return_annotation:RequiredTypeAnnotation> ";" <r:@R> => InterfaceMethodDecl {
        name: id.0,
        name_span: id.1,
        params,
        return_type_annotation: return_annotation,
        span: Span::new(l, r),
    },
};

RequiredTypeAnnotation: TypeAnnotation = {
    <l:@L> <name:"identifier"> "*" <r:@R> => TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: true,
        is_vector: false,
        vector_dims: 0,
    },
    <l:@L> <name:"identifier"> "[" "]" "[" "]" <r:@R> => TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: true,
        vector_dims: 2,
    },
    <l:@L> <name:"identifier"> "[" "]" <r:@R> => TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: true,
        vector_dims: 1,
    },
    <l:@L> <name:"identifier"> <r:@R> => TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: false,
        vector_dims: 0,
    },
};

TypeDecl: TypeDecl = {
    <l:@L> "type" <id:IdentifierWithSpan> <params:TypeDeclParams> <inheritance:TypeInheritance> "{" <members:TypeMembers> "}" <r:@R> => {
        let mut attributes = Vec::new();
        let mut methods = Vec::new();

        for member in members {
            match member {
                TypeMemberDecl::Attribute(attribute) => attributes.push(attribute),
                TypeMemberDecl::Method(method) => methods.push(method),
            }
        }

        let (parent_name, parent_span, parent_init_exprs) = inheritance;

        TypeDecl {
            name: id.0,
            name_span: id.1,
            params,
            parent_name,
            parent_span,
            parent_init_exprs,
            attributes,
            methods,
            span: Span::new(l, r),
        }
    },
};

TypeInheritance: (Option<String>, Option<Span>, Vec<Expr>) = {
    => (None, None, vec![]),
    <pl:@L> "inherits" <parent_id:IdentifierWithSpan> "(" <args:CallArgs> ")" <pr:@R> => {
        (Some(parent_id.0), Some(Span::new(pl, pr)), args)
    },
    <pl:@L> "inherits" <parent_id:IdentifierWithSpan> <pr:@R> => {
        (Some(parent_id.0), Some(Span::new(pl, pr)), vec![])
    },
};

TypeDeclParams: Vec<TypeParam> = {
    => vec![],
    "(" ")" => vec![],
    "(" <first:TypeParam> <rest:("," <TypeParam>)*> ")" => {
        let mut params = vec![first];
        for param in rest {
            params.push(param);
        }
        params
    },
};

TypeParam: TypeParam = {
    <l:@L> <name:"identifier"> <annotation:OptionalTypeAnnotation> <r:@R> => TypeParam {
        name,
        type_annotation: annotation,
        span: Span::new(l, r),
    },
};

TypeMembers: Vec<TypeMemberDecl> = {
    => vec![],
    <first:TypeMember> <rest:TypeMembers> => {
        let mut members = vec![first];
        members.extend(rest);
        members
    },
};

TypeMember: TypeMemberDecl = {
    <l:@L> <id:IdentifierWithSpan> <annotation:OptionalTypeAnnotation> "=" <value:Expr> ";" <r:@R> => TypeMemberDecl::Attribute(TypeAttribute {
        name: id.0,
        name_span: id.1,
        type_annotation: annotation,
        value,
        span: Span::new(l, r),
    }),
    <l:@L> <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" <return_annotation:OptionalTypeAnnotation> "=>" <body:Expr> ";" <r:@R> => TypeMemberDecl::Method(MethodDecl {
        name: id.0,
        name_span: id.1,
        params,
        return_type_annotation: return_annotation,
        body,
        span: Span::new(l, r),
    }),
    <l:@L> <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" <return_annotation:OptionalTypeAnnotation> <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body) = body else {
            unreachable!("BlockExpr rule must produce Expr::Block");
        };

        Ok(TypeMemberDecl::Method(MethodDecl {
            name: id.0,
            name_span: id.1,
            params,
            return_type_annotation: return_annotation,
            body: Expr::Block(body),
            span: Span::new(l, r),
        }))
    },
};

FunctionDecl: FunctionDecl = {
    <l:@L> "function" <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" <return_annotation:OptionalTypeAnnotation> "=>" <body:Expr> ";" <r:@R> => FunctionDecl {
        name: id.0,
        name_span: id.1,
        params,
        return_type_annotation: return_annotation,
        body,
        span: Span::new(l, r),
    },
    <l:@L> "function" <id:IdentifierWithSpan> "(" <params:FunctionParams> ")" <return_annotation:OptionalTypeAnnotation> <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body) = body else {
            unreachable!("BlockExpr rule must produce Expr::Block");
        };

        Ok(FunctionDecl {
            name: id.0,
            name_span: id.1,
            params,
            return_type_annotation: return_annotation,
            body: Expr::Block(body),
            span: Span::new(l, r),
        })
    },
};

FunctionParams: Vec<FunctionParam> = {
    => vec![],
    <first:FunctionParam> <rest:("," <FunctionParam>)*> => {
        let mut params = vec![first];
        for param in rest {
            params.push(param);
        }
        params
    },
};

FunctionParam: FunctionParam = {
    <l:@L> <name:"identifier"> <annotation:OptionalTypeAnnotation> <r:@R> => FunctionParam {
        name,
        type_annotation: annotation,
        span: Span::new(l, r),
    },
};

Statements: Vec<Statement> = {
    => vec![],
    <first:Statement> <rest:StatementTail> => {
        let mut statements = vec![first];
        statements.extend(rest);
        statements
    },
};

StatementTail: Vec<Statement> = {
    ";" <rest:StatementsAfterSemicolon> => rest,
    => vec![],
};

StatementsAfterSemicolon: Vec<Statement> = {
    => vec![],
    <next:Statement> <rest:StatementTail> => {
        let mut statements = vec![next];
        statements.extend(rest);
        statements
    },
};

Statement: Statement = {
    <l:@L> "let" <id:IdentifierWithSpan> <annotation:OptionalTypeAnnotation> "=" <value:Expr> <r:@R> => Statement::Let {
        name: id.0,
        name_span: id.1,
        type_annotation: annotation,
        value,
        span: Span::new(l, r),
    },
    ForStatement,
    <l:@L> <id:IdentifierWithSpan> "=" <value:Expr> <r:@R> => Statement::Assign {
        name: id.0,
        name_span: id.1,
        value,
        span: Span::new(l, r),
    },
    <l:@L> <value:Expr> <r:@R> => Statement::Expr {
        value,
        span: Span::new(l, r),
    },
};

ForStatement: Statement = {
    <l:@L> "for" "(" <id:IdentifierWithSpan> "in" <iter:Expr> ")" <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body_block) = body else {
            return Err(lalrpop_util::ParseError::User {
                error: "for body must be a block".to_string(),
            });
        };
        Ok(Statement::Expr {
            value: Expr::For(ForExpr {
                id: id.0,
                id_span: id.1,
                iter: Box::new(iter),
                body: body_block,
                span: Span::new(l, r),
            }),
            span: Span::new(l, r),
        })
    },
};

Expr: Expr = {
    Conditional,
};

Conditional: Expr = {
    IfExpr,
    LetIn,
};

LetIn: Expr = {
    <l:@L> "let" <bindings:LetBindings> "in" <body:Expr> <r:@R> => Expr::LetIn(LetInExpr {
        bindings,
        body: Box::new(body),
        span: Span::new(l, r),
    }),
    Assignment,
};

LetBindings: Vec<LetBinding> = {
    <first:LetBinding> <rest:("," <LetBinding>)*> => {
        let mut items = Vec::new();
        items.push(first);
        for binding in rest {
            items.push(binding);
        }
        items
    }
};

LetBinding: LetBinding = {
    <l:@L> <id:IdentifierWithSpan> <annotation:OptionalTypeAnnotation> "=" <value:Expr> <r:@R> => LetBinding {
        name: id.0,
        type_annotation: annotation,
        value,
        span: Span::new(l, r),
    },
};

OptionalTypeAnnotation: Option<TypeAnnotation> = {
    <l:@L> ":" <name:"identifier"> "*" <r:@R> => Some(TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: true,
        is_vector: false,
        vector_dims: 0,
    }),
    <l:@L> ":" <name:"identifier"> "[" "]" "[" "]" <r:@R> => Some(TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: true,
        vector_dims: 2,
    }),
    <l:@L> ":" <name:"identifier"> "[" "]" <r:@R> => Some(TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: true,
        vector_dims: 1,
    }),
    <l:@L> ":" <name:"identifier"> <r:@R> => Some(TypeAnnotation {
        name,
        span: Span::new(l, r),
        is_splat: false,
        is_vector: false,
        vector_dims: 0,
    }),
    => None,
};

Assignment: Expr = {
    <l:@L> <target_expr:AssignmentTargetExpr> ":=" <value:Assignment> <r:@R> =>? {
        let target = match target_expr {
            Expr::Variable { name, span } => AssignTarget::Variable {
                name,
                name_span: span,
            },
            Expr::MemberAccess(access) => AssignTarget::Member {
                object: access.object,
                member: access.member,
                member_span: access.member_span,
                span: access.span,
            },
            Expr::ArrayIndex(index_expr) => AssignTarget::Index {
                object: index_expr.object,
                index: index_expr.index,
                span: index_expr.span,
            },
            _ => {
                return Err(lalrpop_util::ParseError::User {
                    error: "Invalid assignment target for ':='. Expected a variable, member access, or array index.".to_string(),
                });
            }
        };

        Ok(Expr::DestructiveAssign(DestructiveAssignExpr {
            target,
            value: Box::new(value),
            span: Span::new(l, r),
        }))
    },
    LogicalOr,
};

AssignmentTargetExpr: Expr = {
    PostfixExpr,
};

LogicalOr: Expr = {
    <l:@L> <left:LogicalOr> "||" <right:LogicalAnd> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Or,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    LogicalAnd,
};

LogicalAnd: Expr = {
    <l:@L> <left:LogicalAnd> "&&" <right:Equality> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::And,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Equality,
};

Equality: Expr = {
    <l:@L> <left:Equality> "==" <right:AsExpr> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Equal,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Equality> "!=" <right:AsExpr> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::NotEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Equality> "is" <target:IdentifierWithSpan> <r:@R> => Expr::Is(IsExpr {
        expr: Box::new(left),
        target_type: target.0,
        target_type_span: target.1,
        span: Span::new(l, r),
    }),
    AsExpr,
};

AsExpr: Expr = {
    <l:@L> <expr:Comparison> "as" <target:IdentifierWithSpan> <r:@R> => Expr::As(AsExpr {
        expr: Box::new(expr),
        target_type: target.0,
        target_type_span: target.1,
        span: Span::new(l, r),
    }),
    Comparison,
};

Comparison: Expr = {
    <l:@L> <left:Comparison> "<" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Less,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> ">" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Greater,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> "<=" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::LessEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Comparison> ">=" <right:Term> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::GreaterEqual,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Term,
};

Term: Expr = {
    <l:@L> <left:Term> "+" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Add,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Term> "@" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Concat,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Term> "@@" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::ConcatSpace,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Term> "-" <right:Factor> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Sub,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Factor,
};

Factor: Expr = {
    <l:@L> <left:Factor> "*" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Mul,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Factor> "/" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Div,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    <l:@L> <left:Factor> "%" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Mod,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Unary,
};

Unary: Expr = {
    <l:@L> "!" <expr:Unary> <r:@R> => Expr::Unary(UnaryExpr {
        op: UnaryOp::Not,
        expr: Box::new(expr),
        span: Span::new(l, r),
    }),
    <l:@L> "-" <expr:Unary> <r:@R> => Expr::Unary(UnaryExpr {
        op: UnaryOp::Neg,
        expr: Box::new(expr),
        span: Span::new(l, r),
    }),
    Power,
};

Power: Expr = {
    <l:@L> <left:Primary> "^" <right:Unary> <r:@R> => Expr::Binary(BinaryExpr {
        left: Box::new(left),
        op: BinaryOp::Pow,
        right: Box::new(right),
        span: Span::new(l, r),
    }),
    Primary,
};

Primary: Expr = {
    WhileExpr,
    BraceExpr,
    PostfixExpr,
};

PostfixExpr: Expr = {
    <l:@L> <receiver:PostfixExpr> "." <id:IdentifierWithSpan> "(" <args:CallArgs> ")" <r:@R> => Expr::MethodCall(MethodCallExpr {
        receiver: Box::new(receiver),
        method_name: id.0,
        method_name_span: id.1,
        args,
        span: Span::new(l, r),
    }),
    <l:@L> <object:PostfixExpr> "." <id:IdentifierWithSpan> <r:@R> => Expr::MemberAccess(MemberAccessExpr {
        object: Box::new(object),
        member: id.0,
        member_span: id.1,
        span: Span::new(l, r),
    }),
    <l:@L> <object:PostfixExpr> "[" <index:Expr> "]" <r:@R> => Expr::ArrayIndex(ArrayIndexExpr {
        object: Box::new(object),
        index: Box::new(index),
        span: Span::new(l, r),
    }),
    PrimaryAtom,
};

PrimaryAtom: Expr = {
    <call:BuiltinCallExpr> => call,
    <call:FunctionCallExpr> => call,
    <new_expr:NewExpr> => new_expr,
    <literal:LiteralExpr> => literal,
    <variable:VariableExpr> => variable,
    "(" <expr:Expr> ")" => expr,
};

FunctionCallExpr: Expr = {
    <l:@L> <id:IdentifierWithSpan> "(" <args:CallArgs> ")" <r:@R> => Expr::FunctionCall(FunctionCallExpr {
        name: id.0,
        name_span: id.1,
        args,
        span: Span::new(l, r),
    }),
};

NewExpr: Expr = {
    <l:@L> "new" <id:IdentifierWithSpan> "(" <args:CallArgs> ")" <r:@R> => Expr::New(NewExpr {
        type_name: id.0,
        type_name_span: id.1,
        args,
        span: Span::new(l, r),
    }),
    <l:@L> "new" <id:IdentifierWithSpan> "[" <size:Expr> "]" "{" <param:IdentifierWithSpan> "->" <body:Expr> "}" <r:@R> => Expr::NewArray(NewArrayExpr {
        type_name: id.0,
        type_name_span: id.1,
        sizes: vec![size],
        element_type_dims: 0,
        initializer: Some(LambdaExpr {
            param_name: param.0,
            param_span: param.1,
            body: Box::new(body),
            span: Span::new(l, r),
        }),
        span: Span::new(l, r),
    }),
    <l:@L> "new" <id:IdentifierWithSpan> "[" "]" "[" <size:Expr> "]" <r:@R> => Expr::NewArray(NewArrayExpr {
        type_name: id.0,
        type_name_span: id.1,
        sizes: vec![size],
        element_type_dims: 1,
        initializer: None,
        span: Span::new(l, r),
    }),
    <l:@L> "new" <id:IdentifierWithSpan> "[" <size:Expr> "]" <r:@R> => Expr::NewArray(NewArrayExpr {
        type_name: id.0,
        type_name_span: id.1,
        sizes: vec![size],
        element_type_dims: 0,
        initializer: None,
        span: Span::new(l, r),
    }),
};

CallArgs: Vec<Expr> = {
    => vec![],
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut args = vec![first];
        for arg in rest {
            args.push(arg);
        }
        args
    },
};

IfExpr: Expr = {
    <l:@L> "if" "(" <condition:Expr> ")" <then_branch:Expr> "else" <else_branch:Expr> <r:@R> => {
        Expr::If(IfExpr {
            condition: Box::new(condition),
            then_branch: Box::new(then_branch),
            elif_branches: Vec::new(),
            else_branch: Box::new(else_branch),
            span: Span::new(l, r),
        })
    },
    <l:@L> "if" "(" <condition:Expr> ")" <then_branch:Expr> <elif_branches:ElifBranches> "else" <else_branch:Expr> <r:@R> => {
        Expr::If(IfExpr {
            condition: Box::new(condition),
            then_branch: Box::new(then_branch),
            elif_branches,
            else_branch: Box::new(else_branch),
            span: Span::new(l, r),
        })
    },
};

ElifBranches: Vec<ElifBranch> = {
    <first:ElifBranch> <rest:ElifBranch*> => {
        let mut branches = vec![first];
        branches.extend(rest);
        branches
    },
};

ElifBranch: ElifBranch = {
    <l:@L> "elif" "(" <condition:Expr> ")" <body:Expr> <r:@R> => ElifBranch {
        condition,
        body,
        span: Span::new(l, r),
    },
};

BuiltinCallExpr: Expr = {
    <l:@L> "sin" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Sin,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "cos" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Cos,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "sqrt" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Sqrt,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "print" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
    function: BuiltinFunction::Print,
    args: vec![arg],
    span: Span::new(l, r),
    }),
    <l:@L> "exp" "(" <arg:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Exp,
        args: vec![arg],
        span: Span::new(l, r),
    }),
    <l:@L> "log" "(" <base:Expr> "," <value:Expr> ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Log,
        args: vec![base, value],
        span: Span::new(l, r),
    }),
    <l:@L> "rand" "(" ")" <r:@R> => Expr::BuiltinCall(BuiltinCallExpr {
        function: BuiltinFunction::Rand,
        args: vec![],
        span: Span::new(l, r),
    }),
    <l:@L> "range" "(" <min:Expr> "," <max:Expr> ")" <r:@R> => Expr::New(NewExpr {
        type_name: "Range".to_string(),
        type_name_span: Span::new(l, r),
        args: vec![min, max],
        span: Span::new(l, r),
    }),
};

IdentifierWithSpan: (String, Span) = {
    <l:@L> <name:"identifier"> <r:@R> => (name, Span::new(l, r)),
};

VariableExpr: Expr = {
    <l:@L> <name:"identifier"> <r:@R> => Expr::Variable {
        name,
        span: Span::new(l, r),
    },
};

BlockExpr: Expr = {
    <l:@L> "{" <statements:Statements> "}" <r:@R> => Expr::Block(BlockExpr {
        statements,
        span: Span::new(l, r),
    }),
};

BraceExpr: Expr = {
    <l:@L> "{" <first:Expr> "," <rest:CommaExprs> "}" <r:@R> => Expr::ArrayLiteral(ArrayLiteralExpr {
        elements: {
            let mut v = vec![first];
            v.extend(rest);
            v
        },
        span: Span::new(l, r),
    }),
    <l:@L> "{" <statements:Statements> "}" <r:@R> => Expr::Block(BlockExpr {
        statements,
        span: Span::new(l, r),
    }),
};

CommaExprs: Vec<Expr> = {
    => vec![],
    <first:Expr> <rest:("," <Expr>)*> => {
        let mut v = vec![first];
        for e in rest {
            v.push(e);
        }
        v
    },
};

WhileExpr: Expr = {
    <l:@L> "while" "(" <condition:Expr> ")" <body:BlockExpr> <r:@R> =>? {
        let Expr::Block(body) = body else {
            unreachable!("BlockExpr rule must produce Expr::Block");
        };

        Ok(Expr::While(WhileExpr {
            condition: Box::new(condition),
            body,
            span: Span::new(l, r),
        }))
    },
};

LiteralExpr: Expr = {
    <l:@L> "PI" <r:@R> => Expr::Literal {
        value: Literal::Float(std::f64::consts::PI),
        span: Span::new(l, r),
    },
    <l:@L> "E" <r:@R> => Expr::Literal {
        value: Literal::Float(std::f64::consts::E),
        span: Span::new(l, r),
    },
    <l:@L> <raw:"number"> <r:@R> =>? {
        if raw.contains('.') {
            match raw.parse::<f64>() {
                Ok(v) => Ok(Expr::Literal {
                    value: Literal::Float(v),
                    span: Span::new(l, r),
                }),
                Err(_) => Err(lalrpop_util::ParseError::User {
                    error: format!("Invalid float literal: {}", raw),
                }),
            }
        } else {
            match raw.parse::<i64>() {
                Ok(v) => Ok(Expr::Literal {
                    value: Literal::Integer(v),
                    span: Span::new(l, r),
                }),
                Err(_) => Err(lalrpop_util::ParseError::User {
                    error: format!("Invalid integer literal: {}", raw),
                }),
            }
        }
    },
    <l:@L> <raw:"boolean"> <r:@R> => Expr::Literal {
        value: Literal::Boolean(raw == "true"),
        span: Span::new(l, r),
    },
    <l:@L> <raw:"string"> <r:@R> => Expr::Literal {
        value: Literal::String(raw),
        span: Span::new(l, r),
    },
    <l:@L> "null" <r:@R> => Expr::Literal {
        value: Literal::Null,
        span: Span::new(l, r),
    },
};
